{
  "name": "openpos",
  "version": "0.1.0",
  "description": "A local-first, touch-friendly point of sale for independent businesses.",
  "author": "OpenPOS contributors",
  "license": "Apache-2.0",
  "private": true,
  "main": "dist/main/main.js",
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "start": "electron .",
    "build": "node scripts/icons.cjs && node scripts/notices.cjs && webpack --mode production",
    "build:dev": "node scripts/icons.cjs && node scripts/notices.cjs && webpack --mode development",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify": "yarn typecheck && yarn test && yarn build && yarn test:e2e",
    "pack": "yarn build && electron-builder --win --x64 --dir --publish never",
    "dist": "yarn build && electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "@mdi/js": "7.4.47",
    "@mdi/react": "1.6.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "copy-webpack-plugin": "^13.0.1",
    "css-loader": "^7.1.2",
    "electron": "44.5.0",
    "electron-builder": "26.15.3",
    "html-webpack-plugin": "^5.6.4",
    "prettier": "^3.6.2",
    "sharp": "^0.34.5",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.4",
    "typescript": "5.9.3",
    "vite": "^8.0.0",
    "vitest": "5.0.2",
    "webpack": "5.111.1",
    "webpack-cli": "7.2.3"
  }
}
